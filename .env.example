# API Keys
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
GROQ_API_KEY=...

# Database
DATABASE_URL=postgresql://bytebot:password@localhost:5433/bytebot
REDIS_URL=redis://localhost:6379

# Services
BYTEBOT_UI_PORT=9992
BYTEBOT_AGENT_PORT=9991
BYTEBOT_DESKTOP_PORT=9990
BYTEBOT_LLM_PROXY_PORT=9993

# Environment
NODE_ENV=development
LOG_LEVEL=info

# Security
JWT_SECRET=your-jwt-secret
ENCRYPTION_KEY=your-encryption-key

# MCP Servers
MCP_FILESYSTEM_ENABLED=true
MCP_WEB_SEARCH_ENABLED=true
MCP_CODE_ANALYSIS_ENABLED=true
# Bytebot AI桌面代理配置文件
# 复制此文件为 .env.bytebot 并填入真实的API密钥

# ======================
# AI模型配置策略
# ======================

# 模型优先级策略 (local, cloud, hybrid)
# local: 优先使用本地模型
# cloud: 优先使用云端API
# hybrid: 智能选择 (简单任务用本地，复杂任务用云端)
AI_MODEL_STRATEGY=hybrid

# 默认AI模型提供商 (anthropic, openai, gemini, ollama, local)
DEFAULT_AI_PROVIDER=ollama

# ======================
# 本地AI模型配置 (Ollama)
# ======================

# Ollama服务地址
OLLAMA_BASE_URL=http://localhost:11434

# Ollama默认模型 (推荐: llama3.1, qwen2.5, deepseek-coder)
OLLAMA_MODEL=llama3.1:8b

# Ollama备用模型列表 (逗号分隔)
OLLAMA_BACKUP_MODELS=qwen2.5:7b,deepseek-coder:6.7b,llama3.1:70b

# Ollama模型参数
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=4096
OLLAMA_TIMEOUT=300

# ======================
# 本地AI模型配置 (LocalAI)
# ======================

# LocalAI服务地址
LOCALAI_BASE_URL=http://localhost:8080

# LocalAI默认模型
LOCALAI_MODEL=llama-3.1-8b-instruct

# LocalAI API密钥 (如果需要)
LOCALAI_API_KEY=your-localai-key

# ======================
# 本地AI模型配置 (vLLM)
# ======================

# vLLM服务地址
VLLM_BASE_URL=http://localhost:8000

# vLLM模型名称
VLLM_MODEL=microsoft/DialoGPT-medium

# ======================
# 云端AI模型API密钥配置
# ======================

# Anthropic Claude API密钥 (推荐，性能最佳)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# OpenAI GPT API密钥 (备用选项)
OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini API密钥 (可选)
GEMINI_API_KEY=your-gemini-key-here

# ======================
# 智能模型路由配置
# ======================

# 任务复杂度阈值 (1-10, 超过此值使用云端模型)
TASK_COMPLEXITY_THRESHOLD=7

# 本地模型性能监控
LOCAL_MODEL_PERFORMANCE_MONITORING=true

# 模型切换延迟容忍度 (秒)
MODEL_SWITCH_TOLERANCE=30

# ======================
# 数据库配置
# ======================

# PostgreSQL数据库连接URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bytebotdb

# ======================
# 服务端口配置
# ======================

# Bytebot桌面服务端口 (noVNC + 桌面控制)
BYTEBOT_DESKTOP_PORT=9990

# Bytebot代理服务端口 (AI处理服务)
BYTEBOT_AGENT_PORT=9991

# Bytebot Web UI端口 (用户界面)
BYTEBOT_UI_PORT=9992

# Ollama服务端口 (本地AI模型)
OLLAMA_PORT=11434

# LocalAI服务端口 (本地AI模型)
LOCALAI_PORT=8080

# ======================
# 服务URL配置
# ======================

# Bytebot桌面服务基础URL
BYTEBOT_DESKTOP_BASE_URL=http://localhost:9990

# Bytebot代理服务基础URL
BYTEBOT_AGENT_BASE_URL=http://localhost:9991

# Bytebot桌面VNC WebSocket URL
BYTEBOT_DESKTOP_VNC_URL=http://localhost:9990/websockify

# ======================
# 火鸟门户集成配置
# ======================

# 火鸟门户前端URL
HUONIAO_PORTAL_URL=http://localhost:3000

# Firecrawl API集成URL
FIRECRAWL_API_URL=http://localhost:8000

# Redis缓存URL (与火鸟门户共享)
REDIS_URL=redis://localhost:6379

# N8N工作流管理URL
N8N_URL=http://localhost:5678

# ======================
# 安全配置
# ======================

# JWT密钥 (用于API认证)
JWT_SECRET=your-jwt-secret-key-here

# 管理员API密钥 (用于高级操作)
ADMIN_API_KEY=your-admin-api-key-here

# ======================
# 性能配置
# ======================

# Docker共享内存大小 (建议2GB以上)
SHM_SIZE=2g

# 并发任务限制
MAX_CONCURRENT_TASKS=5

# 任务超时时间 (秒)
TASK_TIMEOUT=3600

# 本地模型GPU配置
GPU_ENABLED=true
GPU_DEVICE_IDS=0,1  # GPU设备ID，多个用逗号分隔
GPU_MEMORY_LIMIT=8G  # GPU内存限制

# ======================
# 日志配置
# ======================

# 日志级别 (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE_PATH=./logs/bytebot.log

# 模型性能日志
MODEL_PERFORMANCE_LOG=./logs/bytebot/model_performance.log

# ======================
# 开发模式配置
# ======================

# 开发模式开关 (production, development)
NODE_ENV=production

# 调试模式开关
DEBUG=false

# 热重载开关 (仅开发环境)
HOT_RELOAD=false

# 模型性能基准测试
ENABLE_MODEL_BENCHMARKS=false
