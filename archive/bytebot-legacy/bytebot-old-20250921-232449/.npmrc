# ByteBot NPM Configuration
# 优化依赖管理和安装性能

# 使用 npm ci 进行生产环境安装
save-exact=true

# 启用审计
audit-level=moderate

# 启用过时依赖检查
outdated=true

# 启用包锁定文件
package-lock=true

# 启用严格模式
strict-ssl=true

# 设置缓存目录
cache-min=86400

# 启用进度条
progress=true

# 设置超时时间
timeout=300000

# 启用详细日志
loglevel=warn

# 设置注册表
registry=https://registry.npmjs.org/

# 启用引擎检查
engine-strict=true

# 启用资金信息
fund=false

# 启用审计修复
audit-fix=true
