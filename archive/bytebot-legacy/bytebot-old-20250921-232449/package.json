{
    "name": "bytebot",
    "version": "1.0.0",
    "description": "ByteBot - AI Desktop Agent Platform",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "install:all": "npm install",
        "build:all": "npm run build --workspaces",
        "build:shared": "npm run build --workspace=packages/shared",
        "build:agent": "npm run build --workspace=packages/bytebot-agent",
        "build:ui": "npm run build --workspace=packages/bytebot-ui",
        "build:desktop": "npm run build --workspace=packages/bytebotd",
        "start:dev": "npm run start:dev --workspaces",
        "start:agent": "npm run start:dev --workspace=packages/bytebot-agent",
        "start:ui": "npm run start:dev --workspace=packages/bytebot-ui",
        "start:desktop": "npm run start:dev --workspace=packages/bytebotd",
        "lint:all": "npm run lint --workspaces",
        "test:all": "npm run test --workspaces",
        "format:all": "npm run format --workspaces",
        "audit:all": "npm audit --workspaces",
        "outdated:all": "npm outdated --workspaces",
        "update:all": "npm update --workspaces",
        "clean:all": "rm -rf node_modules packages/*/node_modules packages/*/dist",
        "docker:build": "docker-compose -f docker/docker-compose.yml build",
        "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
        "docker:down": "docker-compose -f docker/docker-compose.yml down",
        "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f"
    },
    "devDependencies": {
        "@types/node": "^22.10.7",
        "typescript": "^5.7.3",
        "eslint": "^9.18.0",
        "prettier": "^3.4.2"
    },
    "engines": {
        "node": ">=20.19.4",
        "npm": ">=10.0.0"
    },
    "packageManager": "npm@10.0.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/bytebot-ai/bytebot.git"
    },
    "keywords": [
        "ai",
        "desktop-agent",
        "automation",
        "nestjs",
        "react",
        "typescript"
    ],
    "author": "ByteBot Team",
    "license": "UNLICENSED"
}