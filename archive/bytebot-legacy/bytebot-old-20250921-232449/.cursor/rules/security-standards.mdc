## 数据保护

### 敏感数据加密
```typescript
import crypto from 'crypto';

export class EncryptionService {
    private readonly algorithm = 'aes-256-gcm';
    private readonly secretKey: Buffer;
    
    constructor() {
        const key = process.env.ENCRYPTION_KEY;
        if (!key) {
            throw new Error('ENCRYPTION_KEY not configured');
        }
        this.secretKey = Buffer.from(key, 'hex');
    }
    
    public encrypt(text: string): { encrypted: string; iv: string; tag: string } {
        const iv = crypto.randomBytes(16);
        const cipher = crypto.createCipher(this.algorithm, this.secretKey);
        cipher.setAAD(Buffer.from('ByteBot', 'utf8'));
        
        let encrypted = cipher.update(text, 'utf8', 'hex');
        encrypted += cipher.final('hex');
        
        const tag = cipher.getAuthTag();
        
        return {
            encrypted,
            iv: iv.toString('hex'),
            tag: tag.toString('hex')
        };
    }
    
    public decrypt(encryptedData: { encrypted: string; iv: string; tag: string }): string {
        const decipher = crypto.createDecipher(this.algorithm, this.secretKey);
        decipher.setAAD(Buffer.from('ByteBot', 'utf8'));
        decipher.setAuthTag(Buffer.from(encryptedData.tag, 'hex'));
        
        let decrypted = decipher.update(encryptedData.encrypted, 'hex', 'utf8');
        decrypted += decipher.final('utf8');
        
        return decrypted;
    }
}

export const encryptionService = new EncryptionService();
```

### 数据脱敏
```typescript
export function maskSensitiveData(data: any): any {
    if (typeof data !== 'object' || data === null) {
        return data;
    }
    
    const sensitiveFields = ['password', 'apiKey', 'token', 'secret'];
    const maskedData = { ...data };
    
    for (const key in maskedData) {
        if (sensitiveFields.some(field => key.toLowerCase().includes(field))) {
            maskedData[key] = '***masked***';
        } else if (typeof maskedData[key] === 'object') {
            maskedData[key] = maskSensitiveData(maskedData[key]);
        }
    }
    
    return maskedData;
}

// 日志记录时使用
console.log('User data:', maskSensitiveData(userData));
```

## 安全日志记录

### 安全事件记录
```typescript
export enum SecurityEventType {
    LOGIN_SUCCESS = 'login_success',
    LOGIN_FAILURE = 'login_failure',
    PERMISSION_DENIED = 'permission_denied',
    INVALID_TOKEN = 'invalid_token',
    RATE_LIMIT_EXCEEDED = 'rate_limit_exceeded',
    SUSPICIOUS_ACTIVITY = 'suspicious_activity'
}

interface SecurityEvent {
    type: SecurityEventType;
    userId?: string;
    ip: string;
    userAgent: string;
    details?: any;
    timestamp: Date;
}

export class SecurityLogger {
    public logEvent(event: Omit<SecurityEvent, 'timestamp'>): void {
        const securityEvent: SecurityEvent = {
            ...event,
            timestamp: new Date()
        };
        
        // 记录到安全日志文件
        console.log('SECURITY_EVENT:', JSON.stringify(securityEvent));
        
        // 对于严重事件，可以发送告警
        if (this.isCriticalEvent(event.type)) {
            this.sendAlert(securityEvent);
        }
    }
    
    private isCriticalEvent(type: SecurityEventType): boolean {
        return [
            SecurityEventType.SUSPICIOUS_ACTIVITY,
            SecurityEventType.RATE_LIMIT_EXCEEDED
        ].includes(type);
    }
    
    private sendAlert(event: SecurityEvent): void {
        // 发送安全告警的逻辑
        console.error('SECURITY_ALERT:', event);
    }
}

export const securityLogger = new SecurityLogger();

// 在 API 中使用
export default async function handler(req: NextApiRequest, res: NextApiResponse) {
    try {
        // API 逻辑...
        
        securityLogger.logEvent({
            type: SecurityEventType.LOGIN_SUCCESS,
            userId: user.id,
            ip: req.ip || 'unknown',
            userAgent: req.headers['user-agent'] || 'unknown'
        });
        
    } catch (error) {
        securityLogger.logEvent({
            type: SecurityEventType.LOGIN_FAILURE,
            ip: req.ip || 'unknown',
            userAgent: req.headers['user-agent'] || 'unknown',
            details: { error: error.message }
        });
    }
}
```

