## 性能优化

### 组件优化
```tsx
import { memo, useMemo, useCallback } from 'react';

// 使用 memo 避免不必要的重渲染
export const MessageList = memo<MessageListProps>(({ messages, onMessageClick }) => {
    // 使用 useMemo 优化列表渲染
    const renderedMessages = useMemo(() => {
        return messages.map(message => (
            <MessageItem
                key={message.id}
                message={message}
                onClick={onMessageClick}
            />
        ));
    }, [messages, onMessageClick]);
    
    return <div className="message-list">{renderedMessages}</div>;
});
```

