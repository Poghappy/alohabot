# AI 模型集成规则

## LiteLLM 代理规范

### 代理配置
- 使用 LiteLLM 作为统一的 LLM 代理
- 支持 100+ 模型提供商
- 实现智能路由和负载均衡
- 提供统一的 API 接口

### 配置文件结构
```yaml
# litellm-config.yaml
model_list:
  # 本地模型
  - model_name: local-qwen3-32b
    litellm_params:
      model: ollama/qwen3:32b
      api_base: http://ollama:11434
      api_key: os.environ/OLLAMA_API_KEY
  
  # 云端模型
  - model_name: gpt-4o
    litellm_params:
      model: gpt-4o
      api_key: os.environ/OPENAI_API_KEY
  
  - model_name: claude-3-5-sonnet
    litellm_params:
      model: claude-3-5-sonnet-20241022
      api_key: os.environ/ANTHROPIC_API_KEY

# 路由配置
router_settings:
  routing_strategy: "least-busy"
  model_group_alias:
    "smart-model": ["local-qwen3-32b", "gpt-4o", "claude-3-5-sonnet"]
  
  # 故障转移
  fallback_models:
    - "gpt-4o"
    - "claude-3-5-sonnet"
  
  # 成本控制
  model_max_budget:
    gpt-4o: 50
    claude-3-5-sonnet: 50
```

## 模型管理规范

### 模型选择策略
```typescript
// 模型选择服务
@Injectable()
export class ModelSelectionService {
  async selectBestModel(taskType: TaskType, userPreferences?: UserPreferences): Promise<string> {
    const availableModels = await this.getAvailableModels();
    
    // 根据任务类型选择模型
    switch (taskType) {
      case TaskType.CODING:
        return this.selectCodingModel(availableModels);
      case TaskType.WRITING:
        return this.selectWritingModel(availableModels);
      case TaskType.ANALYSIS:
        return this.selectAnalysisModel(availableModels);
      case TaskType.VISION:
        return this.selectVisionModel(availableModels);
      default:
        return this.selectDefaultModel(availableModels);
    }
  }

  private selectCodingModel(models: Model[]): string {
    // 优先选择编程能力强的模型
    const codingModels = models.filter(m => 
      m.capabilities.includes('coding') && 
      m.status === 'available'
    );
    
    if (codingModels.length > 0) {
      return codingModels[0].name;
    }
    
    return 'gpt-4o'; // 默认回退
  }
}
```

### 模型性能监控
```typescript
// 模型性能监控
@Injectable()
export class ModelPerformanceService {
  async recordModelUsage(
    modelName: string,
    requestId: string,
    startTime: Date,
    endTime: Date,
    tokensUsed: number,
    success: boolean
  ): Promise<void> {
    const duration = endTime.getTime() - startTime.getTime();
    
    await this.performanceRepository.create({
      modelName,
      requestId,
      duration,
      tokensUsed,
      success,
      timestamp: startTime,
    });
    
    // 更新模型统计
    await this.updateModelStatistics(modelName, duration, tokensUsed, success);
  }

  async getModelPerformance(modelName: string): Promise<ModelPerformance> {
    const stats = await this.performanceRepository.getModelStats(modelName);
    
    return {
      averageResponseTime: stats.avgDuration,
      successRate: stats.successRate,
      totalRequests: stats.totalRequests,
      totalTokens: stats.totalTokens,
      costPerToken: stats.costPerToken,
    };
  }
}
```

## 本地模型集成

### Ollama 集成
```typescript
// Ollama 服务集成
@Injectable()
export class OllamaService {
  private readonly baseUrl = process.env.OLLAMA_BASE_URL || 'http://localhost:11434';

  async getAvailableModels(): Promise<OllamaModel[]> {
    const response = await fetch(`${this.baseUrl}/api/tags`);
    const data = await response.json();
    
    return data.models.map((model: any) => ({
      name: model.name,
      size: model.size,
      modifiedAt: model.modified_at,
      digest: model.digest,
    }));
  }

  async pullModel(modelName: string): Promise<void> {
    const response = await fetch(`${this.baseUrl}/api/pull`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: modelName, stream: false }),
    });
    
    if (!response.ok) {
      throw new Error(`Failed to pull model ${modelName}`);
    }
  }

  async generateCompletion(
    model: string,
    prompt: string,
    options: OllamaOptions = {}
  ): Promise<OllamaResponse> {
    const response = await fetch(`${this.baseUrl}/api/generate`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model,
        prompt,
        stream: false,
        ...options,
      }),
    });
    
    if (!response.ok) {
      throw new Error(`Ollama generation failed: ${response.statusText}`);
    }
    
    return response.json();
  }
}
```

### 模型下载管理
```typescript
// 模型下载服务
@Injectable()
export class ModelDownloadService {
  async downloadModel(modelName: string, progressCallback?: (progress: number) => void): Promise<void> {
    const modelInfo = await this.getModelInfo(modelName);
    
    if (!modelInfo) {
      throw new Error(`Model ${modelName} not found`);
    }
    
    // 检查本地是否已存在
    if (await this.isModelDownloaded(modelName)) {
      return;
    }
    
    // 开始下载
    await this.ollamaService.pullModel(modelName);
    
    // 验证下载完整性
    await this.verifyModelIntegrity(modelName);
    
    // 更新本地模型列表
    await this.updateLocalModelList();
  }

  async getDownloadProgress(modelName: string): Promise<number> {
    // 实现下载进度跟踪
    const progress = await this.ollamaService.getPullProgress(modelName);
    return progress;
  }
}
```

## 云端模型集成

### 多提供商支持
```typescript
// 云端模型服务
@Injectable()
export class CloudModelService {
  async generateCompletion(
    modelName: string,
    messages: ChatMessage[],
    options: GenerationOptions = {}
  ): Promise<ModelResponse> {
    const modelConfig = await this.getModelConfig(modelName);
    
    if (!modelConfig) {
      throw new Error(`Model ${modelName} not configured`);
    }
    
    // 根据模型类型选择提供商
    switch (modelConfig.provider) {
      case 'openai':
        return this.generateWithOpenAI(modelName, messages, options);
      case 'anthropic':
        return this.generateWithAnthropic(modelName, messages, options);
      case 'google':
        return this.generateWithGoogle(modelName, messages, options);
      default:
        throw new Error(`Unsupported provider: ${modelConfig.provider}`);
    }
  }

  private async generateWithOpenAI(
    modelName: string,
    messages: ChatMessage[],
    options: GenerationOptions
  ): Promise<ModelResponse> {
    const response = await this.openaiClient.chat.completions.create({
      model: modelName,
      messages: messages.map(msg => ({
        role: msg.role,
        content: msg.content,
      })),
      max_tokens: options.maxTokens,
      temperature: options.temperature,
      stream: options.stream,
    });
    
    return this.mapOpenAIResponse(response);
  }
}
```

### 成本控制
```typescript
// 成本控制服务
@Injectable()
export class CostControlService {
  async checkBudgetLimit(modelName: string, estimatedCost: number): Promise<boolean> {
    const budget = await this.getModelBudget(modelName);
    const currentUsage = await this.getCurrentUsage(modelName);
    
    return (currentUsage + estimatedCost) <= budget;
  }

  async recordUsage(
    modelName: string,
    tokensUsed: number,
    cost: number
  ): Promise<void> {
    await this.usageRepository.create({
      modelName,
      tokensUsed,
      cost,
      timestamp: new Date(),
    });
    
    // 检查是否接近预算限制
    const usage = await this.getCurrentUsage(modelName);
    const budget = await this.getModelBudget(modelName);
    
    if (usage > budget * 0.8) {
      await this.sendBudgetAlert(modelName, usage, budget);
    }
  }
}
```

## 智能路由和负载均衡

### 路由策略
```typescript
// 智能路由服务
@Injectable()
export class IntelligentRoutingService {
  async routeRequest(
    request: ModelRequest,
    availableModels: Model[]
  ): Promise<string> {
    // 根据请求类型选择路由策略
    switch (request.routingStrategy) {
      case 'performance':
        return this.routeByPerformance(availableModels, request);
      case 'cost':
        return this.routeByCost(availableModels, request);
      case 'availability':
        return this.routeByAvailability(availableModels, request);
      case 'hybrid':
        return this.routeByHybrid(availableModels, request);
      default:
        return this.routeByDefault(availableModels, request);
    }
  }

  private async routeByPerformance(
    models: Model[],
    request: ModelRequest
  ): Promise<string> {
    const performanceMetrics = await this.getModelPerformanceMetrics(models);
    
    // 选择响应时间最短的模型
    const bestModel = performanceMetrics.reduce((best, current) => 
      current.avgResponseTime < best.avgResponseTime ? current : best
    );
    
    return bestModel.modelName;
  }

  private async routeByCost(
    models: Model[],
    request: ModelRequest
  ): Promise<string> {
    const costMetrics = await this.getModelCostMetrics(models);
    
    // 选择成本最低的模型
    const cheapestModel = costMetrics.reduce((cheapest, current) => 
      current.costPerToken < cheapest.costPerToken ? current : cheapest
    );
    
    return cheapestModel.modelName;
  }
}
```

### 故障转移
```typescript
// 故障转移服务
@Injectable()
export class FailoverService {
  async executeWithFailover<T>(
    primaryModel: string,
    fallbackModels: string[],
    operation: (model: string) => Promise<T>
  ): Promise<T> {
    try {
      return await operation(primaryModel);
    } catch (error) {
      this.logger.warn(`Primary model ${primaryModel} failed, trying fallback`, error);
      
      for (const fallbackModel of fallbackModels) {
        try {
          return await operation(fallbackModel);
        } catch (fallbackError) {
          this.logger.warn(`Fallback model ${fallbackModel} also failed`, fallbackError);
          continue;
        }
      }
      
      throw new Error('All models failed');
    }
  }

  async markModelAsUnavailable(modelName: string, reason: string): Promise<void> {
    await this.modelStatusRepository.update(modelName, {
      status: 'unavailable',
      lastError: reason,
      unavailableUntil: new Date(Date.now() + 5 * 60 * 1000), // 5分钟后重试
    });
  }
}
```

## 模型缓存和优化

### 响应缓存
```typescript
// 模型响应缓存
@Injectable()
export class ModelCacheService {
  async getCachedResponse(
    modelName: string,
    prompt: string,
    options: GenerationOptions
  ): Promise<ModelResponse | null> {
    const cacheKey = this.generateCacheKey(modelName, prompt, options);
    const cached = await this.redis.get(cacheKey);
    
    if (cached) {
      return JSON.parse(cached);
    }
    
    return null;
  }

  async cacheResponse(
    modelName: string,
    prompt: string,
    options: GenerationOptions,
    response: ModelResponse,
    ttl: number = 3600
  ): Promise<void> {
    const cacheKey = this.generateCacheKey(modelName, prompt, options);
    await this.redis.setex(cacheKey, ttl, JSON.stringify(response));
  }

  private generateCacheKey(
    modelName: string,
    prompt: string,
    options: GenerationOptions
  ): string {
    const hash = crypto
      .createHash('sha256')
      .update(`${modelName}:${prompt}:${JSON.stringify(options)}`)
      .digest('hex');
    
    return `model:cache:${hash}`;
  }
}
```

### 流式响应
```typescript
// 流式响应处理
@Injectable()
export class StreamingService {
  async streamCompletion(
    modelName: string,
    messages: ChatMessage[],
    options: GenerationOptions
  ): Promise<ReadableStream> {
    const modelConfig = await this.getModelConfig(modelName);
    
    if (!modelConfig.supportsStreaming) {
      throw new Error(`Model ${modelName} does not support streaming`);
    }
    
    return this.createStreamingResponse(modelName, messages, options);
  }

  private async createStreamingResponse(
    modelName: string,
    messages: ChatMessage[],
    options: GenerationOptions
  ): Promise<ReadableStream> {
    const encoder = new TextEncoder();
    
    return new ReadableStream({
      async start(controller) {
        try {
          const stream = await this.modelService.generateStream(
            modelName,
            messages,
            options
          );
          
          for await (const chunk of stream) {
            const data = encoder.encode(`data: ${JSON.stringify(chunk)}\n\n`);
            controller.enqueue(data);
          }
          
          controller.close();
        } catch (error) {
          controller.error(error);
        }
      },
    });
  }
}
```

## 模型评估和测试

### 模型性能测试
```typescript
// 模型性能测试
@Injectable()
export class ModelEvaluationService {
  async evaluateModel(
    modelName: string,
    testCases: TestCase[]
  ): Promise<ModelEvaluation> {
    const results = [];
    
    for (const testCase of testCases) {
      const startTime = Date.now();
      
      try {
        const response = await this.modelService.generateCompletion(
          modelName,
          testCase.messages,
          testCase.options
        );
        
        const endTime = Date.now();
        const duration = endTime - startTime;
        
        results.push({
          testCase: testCase.id,
          success: true,
          duration,
          response: response.content,
          tokensUsed: response.tokensUsed,
        });
      } catch (error) {
        results.push({
          testCase: testCase.id,
          success: false,
          error: error.message,
        });
      }
    }
    
    return this.calculateEvaluationMetrics(results);
  }
}
```

### A/B 测试
```typescript
// A/B 测试服务
@Injectable()
export class ABTestingService {
  async runABTest(
    testName: string,
    variants: ModelVariant[],
    trafficSplit: number[] = [0.5, 0.5]
  ): Promise<ABTestResult> {
    const testId = this.generateTestId(testName);
    const results = [];
    
    for (let i = 0; i < variants.length; i++) {
      const variant = variants[i];
      const traffic = trafficSplit[i];
      
      const variantResults = await this.runVariantTest(
        testId,
        variant,
        traffic
      );
      
      results.push(variantResults);
    }
    
    return this.analyzeABTestResults(results);
  }
}
