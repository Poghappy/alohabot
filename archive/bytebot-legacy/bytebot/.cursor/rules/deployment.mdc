### 网络策略
```yaml
# 网络策略
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: bytebot-network-policy
spec:
  podSelector:
    matchLabels:
      app: bytebot-ui
  policyTypes:
  - Ingress
  - Egress
  ingress:
  - from:
    - namespaceSelector:
        matchLabels:
          name: ingress-nginx
    ports:
    - protocol: TCP
      port: 3000
  egress:
  - to:
    - namespaceSelector:
        matchLabels:
          name: bytebot
    ports:
    - protocol: TCP
      port: 9991
```

## 备份和恢复

### 数据库备份
```bash
#!/bin/bash
# 数据库备份脚本

BACKUP_DIR="/backups"
DATE=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="bytebot_backup_${DATE}.sql"

# 创建备份
pg_dump -h $DB_HOST -U $DB_USER -d $DB_NAME > ${BACKUP_DIR}/${BACKUP_FILE}

# 压缩备份
gzip ${BACKUP_DIR}/${BACKUP_FILE}

# 上传到云存储
aws s3 cp ${BACKUP_DIR}/${BACKUP_FILE}.gz s3://bytebot-backups/

# 清理本地备份 (保留7天)
find ${BACKUP_DIR} -name "bytebot_backup_*.sql.gz" -mtime +7 -delete
```

### 应用备份
```bash
#!/bin/bash
# 应用备份脚本

# 备份配置文件
kubectl get configmap bytebot-config -o yaml > backup/configmap_${DATE}.yaml
kubectl get secret bytebot-secrets -o yaml > backup/secret_${DATE}.yaml

# 备份 PVC 数据
kubectl exec -it postgres-0 -- pg_dump -U postgres bytebot > backup/postgres_${DATE}.sql
```

## 回滚策略

### 快速回滚
```bash
#!/bin/bash
# 快速回滚脚本

# 回滚到上一个版本
kubectl rollout undo deployment/bytebot-ui

# 验证回滚成功
kubectl rollout status deployment/bytebot-ui

# 检查服务状态
kubectl get pods -l app=bytebot-ui
kubectl get services bytebot-ui
```

### 数据库回滚
```bash
#!/bin/bash
# 数据库回滚脚本

# 停止应用
kubectl scale deployment bytebot-ui --replicas=0

# 恢复数据库
kubectl exec -it postgres-0 -- psql -U postgres -d bytebot -f /backup/postgres_${BACKUP_DATE}.sql

# 重启应用
kubectl scale deployment bytebot-ui --replicas=3
```

