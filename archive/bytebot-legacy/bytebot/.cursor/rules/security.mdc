### 安全头设置
```typescript
// 安全头中间件
import helmet from 'helmet';

app.use(helmet({
  contentSecurityPolicy: {
    directives: {
      defaultSrc: ["'self'"],
      styleSrc: ["'self'", "'unsafe-inline'"],
      scriptSrc: ["'self'"],
      imgSrc: ["'self'", "data:", "https:"],
    },
  },
  hsts: {
    maxAge: 31536000,
    includeSubDomains: true,
    preload: true,
  },
  noSniff: true,
  xssFilter: true,
}));
```

### 速率限制
```typescript
// 速率限制
import rateLimit from 'express-rate-limit';

const limiter = rateLimit({
  windowMs: 15 * 60 * 1000, // 15 分钟
  max: 100, // 限制每个 IP 15 分钟内最多 100 个请求
  message: 'Too many requests from this IP, please try again later.',
  standardHeaders: true,
  legacyHeaders: false,
});

app.use('/api/', limiter);

// 登录接口特殊限制
const loginLimiter = rateLimit({
  windowMs: 15 * 60 * 1000,
  max: 5, // 15 分钟内最多 5 次登录尝试
  skipSuccessfulRequests: true,
});

app.use('/api/auth/login', loginLimiter);
```

## 日志和监控

### 安全日志
```typescript
// 安全日志服务
@Injectable()
export class SecurityLoggerService {
  private readonly logger = new Logger(SecurityLoggerService.name);

  logLoginAttempt(email: string, success: boolean, ip: string) {
    this.logger.log({
      event: 'login_attempt',
      email,
      success,
      ip,
      timestamp: new Date().toISOString(),
    });
  }

  logSuspiciousActivity(activity: string, userId: string, details: any) {
    this.logger.warn({
      event: 'suspicious_activity',
      activity,
      userId,
      details,
      timestamp: new Date().toISOString(),
    });
  }

  logDataAccess(resource: string, userId: string, action: string) {
    this.logger.log({
      event: 'data_access',
      resource,
      userId,
      action,
      timestamp: new Date().toISOString(),
    });
  }
}
```

### 安全监控
```typescript
// 安全监控服务
@Injectable()
export class SecurityMonitoringService {
  private readonly suspiciousActivities = new Map<string, number>();

  async monitorLoginAttempts(email: string, ip: string): Promise<void> {
    const key = `${email}:${ip}`;
    const attempts = this.suspiciousActivities.get(key) || 0;
    
    if (attempts >= 5) {
      await this.alertSecurityTeam(email, ip, 'Multiple failed login attempts');
      await this.blockIP(ip);
    }
    
    this.suspiciousActivities.set(key, attempts + 1);
  }

  async monitorDataAccess(userId: string, resource: string): Promise<void> {
    // 监控异常数据访问模式
    const accessPattern = await this.getUserAccessPattern(userId);
    
    if (this.isSuspiciousPattern(accessPattern)) {
      await this.alertSecurityTeam(userId, resource, 'Suspicious data access pattern');
    }
  }
}
```

