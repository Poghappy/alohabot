  },
};

// 主题提供者
export const ThemeProvider: React.FC<{ children: React.ReactNode }> = ({
  children
}) => {
  const { theme } = useAppStore();
  
  return (
    <div className={theme} style={themeConfig[theme]}>
      {children}
    </div>
  );
};
